# Kopier til .env.local lokalt, og legg de samme verdiene inn i Vercel.

# Supabase. URL og publishable key er offentlige og trygge i nettleseren.
# I Vercel legges disse inn automatisk av Supabase-integrasjonen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hemmelig nøkkel (sb_secret_...). Bare på serveren. Brukes av Stripe-webhooken og betalingsflyten.
# Supabase-integrasjonen i Vercel kan ha lagt den inn som SUPABASE_SERVICE_ROLE_KEY; begge navn virker.
SUPABASE_SECRET_KEY=

# Stripe (betaling). Bruk test-nøkler (sk_test_/whsec_) til alt er klart for ekte kunder.
STRIPE_SECRET_KEY=
# Fra Stripe → Utviklere → Webhooks → endepunktet https://www.spott.no/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# OpenAI Agents SDK (server only)
OPENAI_API_KEY=
# Optional: override the default model
OPENAI_DEFAULT_MODEL=gpt-5.6-luna

# Meta: Facebook og Instagram (fase 2 og 4)
META_APP_ID=
META_APP_SECRET=

# LinkedIn (fase 2)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Nøkkel for kryptering av plattform-tokens (32 tilfeldige byte, base64)
TOKEN_ENCRYPTION_KEY=
