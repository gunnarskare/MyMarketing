# Kopier til .env.local lokalt, og legg de samme verdiene inn i Vercel.

# Supabase. URL og publishable key er offentlige og trygge i nettleseren.
# I Vercel legges disse inn automatisk av Supabase-integrasjonen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hemmelig nøkkel (sb_secret_...). Bare på serveren. Trengs først fra fase 2.
SUPABASE_SECRET_KEY=

# Språkmodell (fase 1)
AI_API_KEY=

# Meta: Facebook og Instagram (fase 2 og 4)
META_APP_ID=
META_APP_SECRET=

# LinkedIn (fase 2)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Nøkkel for kryptering av plattform-tokens (32 tilfeldige byte, base64)
TOKEN_ENCRYPTION_KEY=
